{
  "mappings": [
    {
      "id": "read-all-tuples",
      "name": "Read all tuples with no filter",
      "request": {
        "method": "POST",
        "urlPath": "/stores/01H0H40Z9QDYNR71MRAG9FPE7M/read",
        "headers": {
          "Content-Type": {
            "equalTo": "application/json"
          }
        },
        "bodyPatterns": [
          {
            "equalToJson": {}
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "X-Request-ID": "{{randomValue type='UUID'}}"
        },
        "bodyFileName": "read_all_tuples.json"
      }
    },
    {
