  {
    "id": "header-validation-read-changes-pagination",
    "name": "ReadChanges API with pagination headers",
    "request": {
      "method": "GET",
      "urlPath": "/stores/01ARZ3NDEKTSV4RRFFQ69G5FAV/changes",
      "headers": {
        "Accept": {
          "equalTo": "application/json"
        },
        "X-Page-Size": {
          "equalTo": "10"
        }
      },
      "queryParameters": {
        "page_size": {
          "equalTo": "10"
        }
      }
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json",
        "X-Total-Count": "25",
        "X-Page-Size": "10",
        "X-Has-More": "true",
        "Link": "</stores/01ARZ3NDEKTSV4RRFFQ69G5FAV/changes?continuation_token=next123>; rel=\"next\""
      },
      "jsonBody": {
        "changes": [
          {
            "type": "tuple_to_userset",
            "operation": "write",
            "tuple_key": {
              "object": "document:1",
              "relation": "viewer",
              "user": "user:alice"
            },
            "timestamp": "2024-01-01T12:00:00Z"
          }
        ],
        "continuation_token": "next123"
      }
    }
  },
  {
    "id": "header-validation-cors-preflight",
