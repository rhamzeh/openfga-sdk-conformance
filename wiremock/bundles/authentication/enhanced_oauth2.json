{
  "mappings": [
    {
      "id": "oauth2-token-success-first-request",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          {
            "equalToJson": {
              "grant_type": "client_credentials",
              "client_id": "test_client_id",
              "client_secret": "test_client_secret",
              "audience": "https://api.fga.example"
            }
          }
        ],
        "headers": {
          "X-Request-Count": {
            "absent": true
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-cache, no-store",
          "X-Token-Issued-At": "{{now format='yyyy-MM-dd HH:mm:ss'}}",
          "X-Token-Expires-At": "{{now offset='+3600 seconds' format='yyyy-MM-dd HH:mm:ss'}}",
          "X-Request-Count": "1"
        },
        "jsonBody": {
          "access_token": "access_token_{{randomValue length=32 type='ALPHANUMERIC'}}",
          "token_type": "Bearer",
          "expires_in": 3600,
          "scope": "read:tuples write:tuples check:tuples",
          "refresh_token": "refresh_{{randomValue length=48 type='ALPHANUMERIC'}}",
          "issued_at": "{{now}}",
          "expires_at": "{{now offset='+3600 seconds'}}",
          "jti": "{{randomValue length=16 type='ALPHANUMERIC'}}",
          "sub": "test_client_id",
          "aud": "https://api.fga.example"
        }
      }
    },
    {
      "id": "oauth2-token-cached-response",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          {
            "equalToJson": {
              "grant_type": "client_credentials",
              "client_id": "test_client_id",
              "client_secret": "test_client_secret",
              "audience": "https://api.fga.example"
            }
          }
        ],
        "headers": {
          "X-Request-Count": {
            "equalTo": "1"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-cache, no-store",
          "X-Token-Cached": "true",
          "X-Request-Count": "2"
        },
        "jsonBody": {
          "access_token": "cached_token_{{randomValue length=32 type='ALPHANUMERIC'}}",
          "token_type": "Bearer",
          "expires_in": 3500,
          "scope": "read:tuples write:tuples check:tuples",
          "refresh_token": "refresh_{{randomValue length=48 type='ALPHANUMERIC'}}",
          "issued_at": "{{now offset='-100 seconds'}}",
          "expires_at": "{{now offset='+3500 seconds'}}",
          "jti": "{{randomValue length=16 type='ALPHANUMERIC'}}",
          "sub": "test_client_id",
          "aud": "https://api.fga.example"
        }
      }
    },
    {
      "id": "oauth2-token-refresh-with-refresh-token",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.grant_type[?(@=='refresh_token')]"
          },
          {
            "matchesJsonPath": "$.refresh_token[?(@!=null)]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-cache, no-store",
          "X-Token-Refreshed": "true"
        },
        "jsonBody": {
          "access_token": "refreshed_token_{{randomValue length=32 type='ALPHANUMERIC'}}",
          "token_type": "Bearer",
          "expires_in": 3600,
          "scope": "read:tuples write:tuples check:tuples",
          "refresh_token": "new_refresh_{{randomValue length=48 type='ALPHANUMERIC'}}",
          "issued_at": "{{now}}",
          "expires_at": "{{now offset='+3600 seconds'}}",
          "jti": "{{randomValue length=16 type='ALPHANUMERIC'}}",
          "sub": "test_client_id",
          "aud": "https://api.fga.example"
        }
      }
    },
    {
      "id": "oauth2-token-expired-refresh-token",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          {
            "equalToJson": {
              "grant_type": "refresh_token",
              "refresh_token": "expired_refresh_token",
              "client_id": "test_client_id",
              "client_secret": "test_client_secret"
            }
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json",
          "X-Error-Type": "expired_refresh_token"
        },
        "jsonBody": {
          "error": "invalid_grant",
          "error_description": "The provided refresh token is expired, revoked, malformed, or invalid",
          "error_uri": "https://tools.ietf.org/html/rfc6749#section-5.2",
          "timestamp": "{{now}}",
          "correlation_id": "{{randomValue length=16 type='ALPHANUMERIC'}}"
        }
      }
    },
    {
      "id": "oauth2-invalid-client-credentials",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          {
            "equalToJson": {
              "grant_type": "client_credentials",
              "client_id": "invalid_client",
              "client_secret": "invalid_secret",
              "audience": "https://api.fga.example"
            }
          }
        ]
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json",
          "WWW-Authenticate": "Bearer error=\"invalid_client\"",
          "X-Error-Type": "invalid_client"
        },
        "jsonBody": {
          "error": "invalid_client",
          "error_description": "Client authentication failed due to unknown client, no client authentication included, or unsupported authentication method",
          "error_uri": "https://tools.ietf.org/html/rfc6749#section-5.2",
          "timestamp": "{{now}}",
          "correlation_id": "{{randomValue length=16 type='ALPHANUMERIC'}}"
        }
      }
    },
    {
      "id": "oauth2-rate-limited",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "headers": {
          "X-Test-Scenario": {
            "equalTo": "oauth_rate_limit"
          }
        }
      },
      "response": {
        "status": 429,
        "headers": {
          "Content-Type": "application/json",
          "Retry-After": "60",
          "X-RateLimit-Limit": "100",
          "X-RateLimit-Remaining": "0",
          "X-RateLimit-Reset": "{{now offset='+60 seconds'}}"
        },
        "jsonBody": {
          "error": "rate_limit_exceeded",
          "error_description": "Too many token requests. Please wait before retrying",
          "retry_after": 60,
          "timestamp": "{{now}}",
          "correlation_id": "{{randomValue length=16 type='ALPHANUMERIC'}}"
        }
      }
    },
    {
      "id": "oauth2-server-error",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "headers": {
          "X-Test-Scenario": {
            "equalTo": "oauth_server_error"
          }
        }
      },
      "response": {
        "status": 500,
        "headers": {
          "Content-Type": "application/json",
          "X-Error-Type": "server_error"
        },
        "jsonBody": {
          "error": "server_error",
          "error_description": "The authorization server encountered an unexpected condition that prevented it from fulfilling the request",
          "error_uri": "https://tools.ietf.org/html/rfc6749#section-5.2",
          "timestamp": "{{now}}",
          "correlation_id": "{{randomValue length=16 type='ALPHANUMERIC'}}"
        }
      }
    },
    {
      "id": "oauth2-unsupported-grant-type",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.grant_type[?(@=='authorization_code')]"
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json",
          "X-Error-Type": "unsupported_grant_type"
        },
        "jsonBody": {
          "error": "unsupported_grant_type",
          "error_description": "The authorization grant type is not supported by the authorization server",
          "error_uri": "https://tools.ietf.org/html/rfc6749#section-5.2",
          "timestamp": "{{now}}",
          "correlation_id": "{{randomValue length=16 type='ALPHANUMERIC'}}"
        }
      }
    },
    {
      "id": "oauth2-invalid-scope",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          {
            "equalToJson": {
              "grant_type": "client_credentials",
              "client_id": "test_client_id",
              "client_secret": "test_client_secret",
              "audience": "https://api.fga.example",
              "scope": "invalid_scope"
            }
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json",
          "X-Error-Type": "invalid_scope"
        },
        "jsonBody": {
          "error": "invalid_scope",
          "error_description": "The requested scope is invalid, unknown, or malformed",
          "error_uri": "https://tools.ietf.org/html/rfc6749#section-5.2",
          "timestamp": "{{now}}",
          "correlation_id": "{{randomValue length=16 type='ALPHANUMERIC'}}"
        }
      }
    },
    {
      "id": "oauth2-token-introspection-active",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/introspect",
        "bodyPatterns": [
          {
            "matches": "token=access_token_.*"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "active": true,
          "scope": "read:tuples write:tuples check:tuples",
          "client_id": "test_client_id",
          "username": "test_client_id",
          "token_type": "Bearer",
          "exp": "{{now offset='+3600 seconds'}}",
          "iat": "{{now}}",
          "nbf": "{{now}}",
          "sub": "test_client_id",
          "aud": "https://api.fga.example",
          "iss": "https://auth.fga.example",
          "jti": "{{randomValue length=16 type='ALPHANUMERIC'}}"
        }
      }
    },
    {
      "id": "oauth2-token-introspection-inactive",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/introspect",
        "bodyPatterns": [
          {
            "matches": "token=expired_token.*"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "active": false
        }
      }
    }
  ]
}
