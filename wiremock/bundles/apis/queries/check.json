{
  "mappings": [
    {
      "id": "check-success-allowed",
      "name": "Basic successful check - allowed",
      "request": {
        "method": "POST",
        "urlPath": "/stores/01H0H40Z9QDYNR71MRAG9FPE7M/check",
        "headers": {
          "Content-Type": {
            "equalTo": "application/json"
          }
        },
        "bodyPatterns": [
          {
            "equalToJson": {
              "tuple_key": {
                "user": "user:alice",
                "relation": "viewer",
                "object": "document:readme"
              },
              "authorization_model_id": "01H0H40Z9QDYNR71MRAG9FPE7N"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "X-Request-ID": "{{randomValue type='UUID'}}"
        },
        "bodyFileName": "check_success_allowed.json"
      }
    },
