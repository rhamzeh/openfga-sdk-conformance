{
  "mappings": [
    {
      "id": "check-wildcard-user",
      "request": {
        "method": "POST",
        "urlPath": "/stores/01ARZ3NDEKTSV4RRFFQ69G5FAV/check",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.tuple_key.user",
            "equalTo": "user:*"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "allowed": true
        }
      }
    },
    {
