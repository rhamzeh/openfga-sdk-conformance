[
  {
    "id": "header-validation-check-with-custom-headers",
    "name": "Check API with custom request headers",
    "request": {
      "method": "POST",
      "urlPath": "/stores/01ARZ3NDEKTSV4RRFFQ69G5FAV/check",
      "headers": {
        "Content-Type": {
          "equalTo": "application/json"
        },
        "X-Custom-Header": {
          "equalTo": "custom-value"
        },
        "X-Test-ID": {
          "equalTo": "test-123"
        }
      },
      "bodyPatterns": [
        {
          "matchesJsonPath": "$.tuple_key"
        }
      ]
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json",
        "X-Response-ID": "resp-456",
        "X-Processing-Time": "25ms",
        "Cache-Control": "no-cache"
      },
      "jsonBody": {
        "allowed": true,
        "resolution": {}
      }
    }
  },
  {
    "id": "header-validation-check-authorization",
