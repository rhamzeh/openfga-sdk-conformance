    "id": "write-onduplicate-ignore",
    "name": "Write - onDuplicate IGNORE",
    "request": {
      "method": "POST",
      "urlPath": "/stores/01ARZ3NDEKTSV4RRFFQ69G5FAV/write",
      "bodyPatterns": [
        {
          "matchesJsonPath": "$.writes.on_duplicate",
          "equalToJson": "\"IGNORE\""
        }
      ]
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "jsonBody": {
        "writes": [
          {
            "tuple_key": {
              "user": "user:alice",
              "relation": "viewer",
              "object": "document:readme"
            },
            "status": "SUCCESS"
          }
        ]
      }
    }
  },
