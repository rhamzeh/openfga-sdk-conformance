{
  "mappings": [
    {
      "id": "write-single-tuple",
      "name": "Write single tuple",
      "request": {
        "method": "POST",
        "urlPath": "/stores/01H0H40Z9QDYNR71MRAG9FPE7M/write",
        "headers": {
          "Content-Type": {
            "equalTo": "application/json"
          }
        },
        "bodyPatterns": [
          {
            "equalToJson": {
              "writes": {
                "tuple_keys": [
                  {
                    "user": "user:alice",
                    "relation": "viewer",
                    "object": "document:readme"
                  }
                ]
              },
              "authorization_model_id": "01H0H40Z9QDYNR71MRAG9FPE7N"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "X-Request-ID": "{{randomValue type='UUID'}}"
        },
        "bodyFileName": "write_success.json"
      }
    },
